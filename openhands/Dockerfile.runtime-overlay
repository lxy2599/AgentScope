# Emergency/offline runtime overlay for already-built owned AgentLab images.
#
# It is intentionally used only when a clean Dockerfile.task-runner build
# cannot reach the package mirror. The resulting image still has the
# AgentScope SDK copied and checksum-verified at build time; at runtime it
# never mounts or imports the AgentScope checkout. The benchmark launcher must
# reference the resulting image by its immutable sha256 digest.
ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS runtime-overlay

USER root
# Match the normal runtime build: the vendored official Agent Server UI must be
# present even when we rebuild only this offline overlay.
COPY --chown=10001:10001 scripts/agent_server_ui/static /opt/openhands/agent-server-ui
ENV OH_STATIC_FILES_PATH=/opt/openhands/agent-server-ui
COPY --chown=10001:10001 .docker-build-assets/agentscope_sdk /tmp/agentlab-agentscope-sdk
COPY --chown=10001:10001 .docker-build-assets/agentscope_sdk.sha256 /tmp/agentlab-agentscope-sdk.sha256
RUN set -eux; \
    cd /tmp/agentlab-agentscope-sdk; \
    sha256sum --check --strict /tmp/agentlab-agentscope-sdk.sha256; \
    rm -rf /opt/openhands/.venv/lib/python3.13/site-packages/agentscope_sdk; \
    mv /tmp/agentlab-agentscope-sdk /opt/openhands/.venv/lib/python3.13/site-packages/agentscope_sdk; \
    rm -f /tmp/agentlab-agentscope-sdk.sha256
# The native Task Runner is owned source, not an installed upstream plugin.
# Overlay it too when an offline rebuild is required; the resulting image is
# still immutable and digest-pinned, and no package installation happens at
# runtime.
COPY --chown=10001:10001 openhands-agent-server/openhands/agent_server/task_runner.py \
    /opt/openhands/.venv/lib/python3.13/site-packages/openhands/agent_server/task_runner.py
COPY --chown=10001:10001 openhands-sdk/openhands/sdk/tool/spec.py \
    /opt/openhands/.venv/lib/python3.13/site-packages/openhands/sdk/tool/spec.py
USER openhands

# The base image is the interactive Agent Server by default. Keep that
# behavior for unqualified overlay builds, while exposing a second immutable
# output target for the Harbor-owned Task Runner sidecar.
FROM runtime-overlay AS task-runner
ENTRYPOINT ["tini", "--", "openhands-task-runner"]
CMD ["--host", "0.0.0.0", "--port", "8001"]

FROM runtime-overlay AS interactive
