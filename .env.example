# AgentScope 环境变量配置
#
# 复制此文件为 .env 并修改相应值。
# 不要提交 .env 到版本控制。

# ============================================================
# 服务端必需配置
# ============================================================
AGENTSCOPE_HTTP_ADDR=:8080
AGENTSCOPE_DATABASE_URL=postgres://agentscope:agentscope@127.0.0.1:5432/agentscope_test?sslmode=disable
AGENTSCOPE_CLICKHOUSE_DSN=clickhouse://127.0.0.1:19000/agentscope_traces

# 必填：使用密码管理器或 `openssl rand -base64 48` 生成，至少 32 字节。
# 模板故意留空，避免示例密钥被误用于真实部署。
AGENTSCOPE_SESSION_SECRET=
AGENTSCOPE_SESSION_TTL=168h
# 通过 HTTPS 提供服务时必须设为 true。
AGENTSCOPE_SECURE_COOKIES=false

# Docker 映射端口（端口冲突时可覆盖）
AGENTSCOPE_POSTGRES_PORT=5432
AGENTSCOPE_CLICKHOUSE_PORT=19000
AGENTSCOPE_CLICKHOUSE_HTTP_PORT=18123

# ============================================================
# Trace ingestion（可选）
# ============================================================
AGENTSCOPE_INGEST_MAX_BODY_SIZE=10485760
AGENTSCOPE_INGEST_MAX_SPANS=5000
AGENTSCOPE_INGEST_RATE_LIMIT_ENABLED=false
AGENTSCOPE_INGEST_RATE_LIMIT_CAPACITY=100
AGENTSCOPE_INGEST_RATE_LIMIT_REFILL=100
AGENTSCOPE_INGEST_RATE_LIMIT_INTERVAL=1s

# 真实存储集成测试（仅指向名称以 _test 结尾的隔离数据库）
# AGENTSCOPE_TEST_DATABASE_URL=postgres://agentscope:agentscope@127.0.0.1:5432/agentscope_test?sslmode=disable
# AGENTSCOPE_TEST_CLICKHOUSE_DSN=clickhouse://127.0.0.1:19000/agentscope_traces_test

# ============================================================
# LLM 配置（用于真实 Agent 演示）
# ============================================================
# 支持的 provider: deepseek, glm
# AGENTSCOPE_LLM_PROVIDER=deepseek
# AGENTSCOPE_LLM_BASE_URL=https://api.deepseek.com/v1
# AGENTSCOPE_LLM_API_KEY=sk-your-key-here
# AGENTSCOPE_LLM_MODEL=deepseek-chat

# LLM-as-Judge 默认只允许官方 OpenAI / Anthropic origin 及其标准 key 环境变量。
# 接入兼容服务时必须由 runner 运维显式扩展两个白名单（逗号分隔）：
# AGENTSCOPE_JUDGE_ALLOWED_API_KEY_ENVS=DEEPSEEK_API_KEY
# AGENTSCOPE_JUDGE_ALLOWED_BASE_URLS=https://api.deepseek.com
# 仅本机开发且明确接受明文传输风险时，才同时启用：
# AGENTSCOPE_JUDGE_ALLOW_INSECURE_HTTP=false

# GLM 示例:
# AGENTSCOPE_LLM_PROVIDER=glm
# AGENTSCOPE_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AGENTSCOPE_LLM_API_KEY=your-glm-key
# AGENTSCOPE_LLM_MODEL=glm-4.7-flash

# ============================================================
# Benchmark 本机 Runner（可选；由 Web 页面确认启动）
# ============================================================
# 浏览器永远不会接触下面的凭据。服务端收到管理员在“基准评测”详情页的确认后，
# 才会启动受监管的 Python Runner，并将短期项目令牌和模型凭据仅传给该进程。
AGENTSCOPE_BENCHMARK_RUNNER_ENABLED=false
AGENTSCOPE_BENCHMARK_RUNNER_EXECUTABLE=uv
AGENTSCOPE_BENCHMARK_RUNNER_WORKDIR=python
# 官方 Harbor checkout；Runner 会用它的 `uv run ... harbor` 命令启动 Harness。
AGENTSCOPE_BENCHMARK_HARBOR_WORKDIR=.external/harbor
AGENTSCOPE_BENCHMARK_RUNNER_SERVER_URL=http://127.0.0.1:8080
AGENTSCOPE_BENCHMARK_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# 请按火山引擎控制台中实际可用的模型 ID 设置。
AGENTSCOPE_BENCHMARK_MODEL=ark-code-latest
AGENTSCOPE_BENCHMARK_RUNNER_TOKEN_TTL=2h
# 仅在 AgentScope 服务端进程环境设置；不要写入前端、实验配置或 Git。
# ARK_API_KEY=

# ============================================================
# Authentication admission control（默认开启，保护 bcrypt）
# ============================================================
AGENTSCOPE_AUTH_RATE_LIMIT_ENABLED=true
# 留空时按 CPU 核数选择安全的 bcrypt 并发上限（至少 2）。
# AGENTSCOPE_AUTH_BCRYPT_MAX_CONCURRENT=8
AGENTSCOPE_AUTH_RATE_LIMIT_MAX_TRACKED_PRINCIPALS=20000

# ============================================================
# Realtime PostgreSQL fallback 与 outbox retention
# ============================================================
# 默认兼容旧行为：仅在配置 Redis 时启用。设为 true 可启用 PostgreSQL-only
# SSE（Redis 不可用/未部署时退化为轮询读取 durable outbox）。
AGENTSCOPE_REALTIME_ENABLED=true
# Redis 是低延迟加速层；未配置时仍可使用上述 PostgreSQL-only SSE。
# AGENTSCOPE_REDIS_ADDR=127.0.0.1:6379
# AGENTSCOPE_REDIS_PASSWORD=
# AGENTSCOPE_REDIS_DB=0
AGENTSCOPE_REALTIME_POSTGRES_POLL_INTERVAL=1s
AGENTSCOPE_REALTIME_POSTGRES_REPLAY_BATCH_SIZE=100
AGENTSCOPE_REALTIME_OUTBOX_RETENTION=168h
AGENTSCOPE_REALTIME_OUTBOX_CLEANUP_INTERVAL=1h
AGENTSCOPE_REALTIME_OUTBOX_CLEANUP_BATCH_SIZE=1000

# AgentLab local monorepo runtime (copy to .env; do not commit .env)
AGENTLAB_HTTP_PORT=18080
AGENTLAB_POSTGRES_PORT=15432
AGENTLAB_CLICKHOUSE_TCP_PORT=19001
AGENTLAB_CLICKHOUSE_HTTP_PORT=18124
# Host proxy. Containers reach this proxy through host.docker.internal.
AGENTLAB_PROXY_URL=http://127.0.0.1:7897
AGENTLAB_DOCKER_PROXY_URL=http://host.docker.internal:7897
NO_PROXY=localhost,127.0.0.1,::1,agentscope,postgres,clickhouse,openhands,hermes,benchmarks-worker
# Generated automatically by `./scripts/agentlab.sh agents-up` when blank.
AGENTSCOPE_PROJECT_TOKEN=
# Provide model credentials only in your local .env.
ARK_API_KEY=
BENCHMARK_MODEL=openai/deepseek-v4-flash
ARK_BASE_URL=
LLM_BASE_URL=
AGENTLAB_OPENHANDS_PORT=18000
AGENTLAB_HERMES_PORT=18001
HERMES_MODEL=
HERMES_BASE_URL=
HERMES_API_KEY=
AGENTLAB_WORKER_ID=harbor-local
AGENTLAB_WORKER_HEARTBEAT_S=20
AGENTLAB_SIDECAR_NETWORK=agentlab_default
AGENTLAB_TOOL_GATEWAY_HOST=benchmarks-worker
