# Keep deployment builds limited to the Go control plane and React console.
# Runtime images and local credentials must never enter a build context.
*
!.dockerignore
!go.mod
!go.sum
!cmd/
!cmd/**
!internal/
!internal/**
!web/
!web/**
!web/dist/
!web/dist/**
!.runtime/
!.runtime/agentscope-server
!.runtime/agentscope-server/**
.runtime/benchmark-worker
.runtime/benchmark-worker/**
!deploy/
!deploy/**
!benchmarks/
!benchmarks/src/
!benchmarks/src/benchmark_worker/
!benchmarks/src/benchmark_worker/**
web/node_modules
