+def _container_proxy_command(cmd: str) -> str:
+    """Route loopback proxy URLs through the task container's Docker gateway."""
+    return (
+        'gateway_hex=$(awk \'$2 == "00000000" { print $3; exit }\' /proc/net/route 2>/dev/null || true); '
+        'if [[ "$gateway_hex" =~ ^[0-9A-Fa-f]{8}$ ]]; then '
+        'printf -v gateway "%d.%d.%d.%d" "0x${gateway_hex:6:2}" "0x${gateway_hex:4:2}" '
+        '"0x${gateway_hex:2:2}" "0x${gateway_hex:0:2}"; '
+        'else gateway=""; fi; '
+        'for proxy_var in HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy; do '
+        'proxy_value="${!proxy_var:-}"; '
+        'if [[ -n "$gateway" && "$proxy_value" =~ ^(https?://)?127\\.0\\.0\\.1(:|/|$) ]]; then '
+        'export "$proxy_var=${proxy_value/127.0.0.1/$gateway}"; '
+        'elif [[ -n "$gateway" && "$proxy_value" =~ ^(https?://)?localhost(:|/|$) ]]; then '
+        'export "$proxy_var=${proxy_value/localhost/$gateway}"; '
+        'fi; '
+        'done; '
+        + cmd
+    )
+

