+                    f"configured_proxy={configured_proxy}; "
+                    "for source_file in /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do "
+                    '[ -e "$source_file" ] || continue; '
+                    "sed -i 's|http://deb.debian.org|https://deb.debian.org|g; s|http://security.debian.org|https://security.debian.org|g' \"$source_file\"; "
+                    "done; "
+                    "apt_proxy_options=(); "
+                    "if [[ -n \"$configured_proxy\" ]]; then "
+                    "gateway_hex=$(awk '$2 == \"00000000\" { print $3; exit }' /proc/net/route 2>/dev/null || true); "
+                    "if [[ \"$gateway_hex\" =~ ^[0-9A-Fa-f]{8}$ ]]; then "
