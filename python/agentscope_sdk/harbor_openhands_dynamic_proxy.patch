+                    "env -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY "
+                    "-u http_proxy -u https_proxy -u all_proxy "
+                    "apt-get \"${apt_proxy_options[@]}\" -o Acquire::ForceIPv4=true -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 -o Acquire::Retries=2 "
+                    "install -y curl git build-essential tmux"
+                ),
+                env={"DEBIAN_FRONTEND": "noninteractive"},
