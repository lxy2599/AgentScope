+def _node22(cmd: str) -> str:
+    return 'export PATH="$HOME/.local/share/openclaw-node-22/bin:$PATH" && ' + cmd
+
+
+def _container_proxy_command(cmd: str) -> str:
+    """Route localhost proxy URLs through the container's Docker gateway."""
+    return (
+        'gateway_hex=$(awk \'$2 == "00000000" { print $3; exit }\' /proc/net/route 2>/dev/null || true); '
+        'if [[ "$gateway_hex" =~ ^[0-9A-Fa-f]{8}$ ]]; then '
+        'printf -v gateway "%d.%d.%d.%d" "0x${gateway_hex:6:2}" "0x${gateway_hex:4:2}" '
+        '"0x${gateway_hex:2:2}" "0x${gateway_hex:0:2}"; '
+        'else gateway=""; fi; '
+        'for proxy_var in HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy; do '
+        'proxy_value="${!proxy_var:-}"; '
+        'if [[ -n "$gateway" && "$proxy_value" =~ ^(https?://)?127\\.0\\.0\\.1(:|/|$) ]]; then '
+        'export "$proxy_var=${proxy_value/127.0.0.1/$gateway}"; '
+        'elif [[ -n "$gateway" && "$proxy_value" =~ ^(https?://)?localhost(:|/|$) ]]; then '
+        'export "$proxy_var=${proxy_value/localhost/$gateway}"; '
+        'fi; '
+        'done; '
+        + cmd
+    )
+
+
+def _install_prebuilt_node22() -> str:
+    """Install a known-good Node 22 binary without a GitHub-hosted nvm bootstrap."""
+    python_download = shlex.quote(
+        "import os, time, urllib.request\n"
+        'url = os.environ["OPENCLAW_NODE_URL"]\n'
+        'destination = os.environ["OPENCLAW_NODE_ARCHIVE"]\n'
+        "for attempt in range(6):\n"
+        "    try:\n"
+        "        with urllib.request.urlopen(url, timeout=120) as response, open(destination, 'wb') as output:\n"
+        "            output.write(response.read())\n"
+        "        break\n"
+        "    except OSError:\n"
+        "        if attempt == 5:\n"
+        "            raise\n"
+        "        time.sleep(2 * (attempt + 1))\n"
+    )
+    return (
+        "set -euo pipefail; "
+        f'node_version="{OPENCLAW_NODE_VERSION}"; '
+        'case "$(uname -m)" in '
+        'x86_64|amd64) node_arch="x64" ;; '
+        'aarch64|arm64) node_arch="arm64" ;; '
+        '*) echo "Unsupported Node architecture: $(uname -m)" >&2; exit 1 ;; '
+        "esac; "
+        'archive="node-${node_version}-linux-${node_arch}.tar.gz"; '
+        'temporary_dir="$(mktemp -d)"; '
+        'node_root="$HOME/.local/share/openclaw-node-22"; '
+        'if command -v python3 >/dev/null 2>&1; then '
+        'env -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u http_proxy -u https_proxy -u all_proxy '
+        'OPENCLAW_NODE_URL="https://nodejs.org/dist/${node_version}/${archive}" '
+        'OPENCLAW_NODE_ARCHIVE="${temporary_dir}/${archive}" '
+        f"python3 -c {python_download}; "
+        'elif command -v curl >/dev/null 2>&1; then '
+        'env -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u http_proxy -u https_proxy -u all_proxy '
+        'curl -fsSL --retry 5 --retry-delay 2 '
+        '"https://nodejs.org/dist/${node_version}/${archive}" '
+        '-o "${temporary_dir}/${archive}"; '
+        'else echo "OpenClaw requires python3 or curl to install Node.js" >&2; exit 1; fi; '
+        'tar -xzf "${temporary_dir}/${archive}" -C "${temporary_dir}"; '
+        'mkdir -p "$(dirname \"${node_root}\")"; '
+        'mv "${temporary_dir}/node-${node_version}-linux-${node_arch}" '
+        '"${node_root}"; '
+        'export PATH="${node_root}/bin:${PATH}"; '
+        "node -v && npm -v"
+    )


