# Offline release overlay for an already-built AgentLab Worker image.
#
# It makes the locally reviewed benchmark_worker source and the pinned Docker
# Compose plugin available to the normal long-running Worker without fetching
# Python packages or installing Agents at task execution time.  The base image
# is supplied by immutable local digest by the release script.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG DOCKER_COMPOSE_SHA256=f9ebc6ebdb19d769b793c245a736caaeb198c62587f13b25c660c13b4987f959
COPY src/benchmark_worker /tmp/agentlab-benchmark-worker
COPY docker/assets/docker-compose-5.3.1-linux-x86_64 /tmp/docker-compose
COPY docker/install_docker_compose.py /tmp/install_docker_compose.py
RUN set -eux; \
    test -d /opt/venv/lib/python3.13/site-packages; \
    rm -rf /opt/venv/lib/python3.13/site-packages/benchmark_worker; \
    mv /tmp/agentlab-benchmark-worker /opt/venv/lib/python3.13/site-packages/benchmark_worker; \
    DOCKER_COMPOSE_PLUGIN=/tmp/docker-compose DOCKER_COMPOSE_SHA256=${DOCKER_COMPOSE_SHA256} \
      python /tmp/install_docker_compose.py; \
    rm -f /tmp/docker-compose /tmp/install_docker_compose.py
