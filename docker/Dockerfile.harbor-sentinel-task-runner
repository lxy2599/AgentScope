# Deterministic Task Runner v1 fixture for the real Harbor E2E sentinel.
# This is built before a trial and addressable by an immutable image digest.
# It does not install an Agent or any dependency while a benchmark task runs.
FROM python@sha256:9662417aace5ae7b8e2609cce472b72a8958e134ba372808abe9cc1a0c0125e6
WORKDIR /opt/agentlab
COPY scripts/harbor_sentinel_task_runner.py /opt/agentlab/harbor_sentinel_task_runner.py
EXPOSE 8082
ENTRYPOINT ["python", "/opt/agentlab/harbor_sentinel_task_runner.py"]
